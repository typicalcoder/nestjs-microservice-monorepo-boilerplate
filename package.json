{
  "name": "nestjs-microservice-monorepo-boilerplate",
  "version": "1.0.0",
  "description": "NestJS microservice monorepo boilerplate — gateway + microservices, MikroORM/Mongo, RabbitMQ, JWT/OAuth auth",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\" \"tasks/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:dev:gateway": "nest start gateway --watch",
    "start:dev:user": "nest start user --watch",
    "start:debug": "nest start --debug --watch",
    "lint": "eslint \"{apps,libs,tasks}/**/*.ts\" --fix",
    "lint:env": "node tools/audit-env.mjs",
    "e2e:smoke": "bash tools/e2e-smoke.sh",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:ci": "jest --coverage --ci --runInBand"
  },
  "dependencies": {
    "@mikro-orm/core": "^6.5.2",
    "@mikro-orm/mongodb": "^6.5.2",
    "@mikro-orm/nestjs": "^6.1.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/microservices": "^11.0.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "@sentry/node": "^10.49.0",
    "amqp-connection-manager": "^4.1.14",
    "amqplib": "^0.10.9",
    "argon2": "^0.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "date-fns": "^4.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.4.2",
    "mongodb": "^7.2.0",
    "nodemailer": "^8.0.5",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.2",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@mikro-orm/cli": "^6.5.2",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@sentry/cli": "^2.39.1",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.10.7",
    "@types/amqplib": "^0.10.5",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^8.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "babel-jest": "^30.3.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "webpack-node-externals": "^3.0.0"
  },
  "engines": {
    "node": "22.16.0",
    "pnpm": "10.28.0"
  },
  "pnpm": {
    "supportedArchitectures": {
      "os": [
        "current"
      ],
      "cpu": [
        "arm64",
        "x64"
      ]
    },
    "onlyBuiltDependencies": [
      "@sentry/cli",
      "argon2"
    ],
    "ignoredBuiltDependencies": [
      "@nestjs/core",
      "@scarf/scarf"
    ]
  },
  "mikro-orm": {
    "useTsNode": true,
    "configPaths": [
      "./libs/database/src/mikro-orm.config.ts"
    ]
  }
}
