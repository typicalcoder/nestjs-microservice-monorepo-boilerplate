# ─── task: db-migrate ────────────────────────────────────────────────────────
# Standalone k8s Job. Applies pending DB migrations from the local registry,
# records each in _migrations. No HTTP, no RabbitMQ — direct MongoDB only.

NODE_ENV=production

MONGO=mongodb://127.0.0.1:27017/?directConnection=true
MONGO_DB=app-dev
