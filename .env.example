# ─────────────────────────────────────────────────────────────────────────────
# Local-development aggregate .env — union of the vars every service / task
# reads. In prod each service gets only its own subset via k8s ConfigMap /
# Secret (see apps/<svc>/.env.example for the per-service contract).
#
# Running locally:
#   cp .env.example .env
#   fill in JWT secrets (openssl rand -hex 64)
#   docker compose up -d mongodb redis rabbitmq
#   pnpm start:dev:gateway   # and pnpm start:dev:user in another terminal
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development

# ─── Infrastructure (all services) ───────────────────────────────────────────
MONGO=mongodb://127.0.0.1:27017/?directConnection=true
MONGO_DB=app-dev
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://localhost:5672
# In non-dev: per-service creds + dedicated vhost, not guest/guest.
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
# Queue prefix so dev/staging/prod brokers don't cross-deliver. Defaults to
# NODE_ENV; set explicitly per stage.
RMQ_QUEUE_PREFIX=dev

# ─── Gateway only ────────────────────────────────────────────────────────────
PORT=3000
# openssl rand -hex 64
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ─── Gateway only (OAuth verifiers, optional) ────────────────────────────────
# Set only if you ship VK login. VK ID issues a DIFFERENT App ID per mobile
# platform — ship both in prod or logins from the missing platform fail the
# audience check. Unset → gateway still boots; /oauth/vk id_token verification
# answers "provider not configured". Public identifiers (not secrets).
VK_ANDROID_APP_ID=
VK_IOS_APP_ID=
# Server-to-server tokens for calls to api.vk.com without a user context.
# NOT used by the verifier — reserved for future VK API flows.
VK_ANDROID_SERVICE_TOKEN=
VK_IOS_SERVICE_TOKEN=
# Optional URL overrides — defaults are baked into the verifier services:
#   VK_PUBLIC_INFO_URL=https://id.vk.com/oauth2/public_info
#   VK_USERINFO_URL=https://api.vk.com/method/users.get
#   YANDEX_USERINFO_URL=https://login.yandex.ru/info

# ─── user-service only (SMTP — password reset, transactional email) ──────────
# Leave SMTP_HOST blank to run EmailService in stub mode (logs only).
# When HOST is set: SMTP_PORT becomes required; SMTP_PASSWORD becomes required
# iff SMTP_USER is set.
SMTP_HOST=
SMTP_PORT=587
# "true" | "false" | unset (auto-derive: 465→true, else→false).
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@example.com
# Base URL the password-reset link points to (token is appended as ?token=…).
PASSWORD_RESET_URL=https://example.com/reset

# ─── Observability ───────────────────────────────────────────────────────────
# Leave empty to disable. Set in prod.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
RELEASE_TAG=
# silly | debug | verbose | http | info | warn | error — defaults: info in
# prod, debug in dev.
LOG_LEVEL=
# json | pretty — default: pretty when stdout is a TTY, json otherwise.
LOG_FORMAT=
# Prometheus /metrics port for RPC-only services (gateway exposes /metrics on
# its HTTP port instead). Unset to disable.
METRICS_PORT=
