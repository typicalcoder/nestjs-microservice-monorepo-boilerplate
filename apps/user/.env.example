# ─── user-service ────────────────────────────────────────────────────────────
# Owns the User collection + auth-supporting RPC (autoreg, login, OAuth,
# upgrade, password reset). Consumes RPC on <prefix>_user_service_queue.

NODE_ENV=development

# ─── Database (*) ───
MONGO=mongodb://127.0.0.1:27017/?directConnection=true
MONGO_DB=app-dev

# ─── RabbitMQ (consumer) (*) ───
RABBITMQ_URL=amqp://localhost:5672
RMQ_QUEUE_PREFIX=dev

# ─── SMTP (outbound email: password reset) ───
# Leave SMTP_HOST blank to run EmailService in stub mode (logs only) so local
# flows work without an MTA. Any SMTP provider works.
SMTP_HOST=
SMTP_PORT=587
# Auto-derived from port when unset: 465→true, everything else→false
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@example.com
PASSWORD_RESET_URL=https://example.com/reset

# ─── Observability ───
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
RELEASE_TAG=
LOG_LEVEL=
LOG_FORMAT=
METRICS_PORT=
