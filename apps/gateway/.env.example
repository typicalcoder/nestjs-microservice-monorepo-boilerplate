# ─── gateway — HTTP entry point ──────────────────────────────────────────────
# Listens on PORT, proxies to microservices via RabbitMQ, terminates CORS,
# verifies/issues JWTs. Vars with (*) are required at startup — bootstrap
# fails loudly if missing.

# ─── HTTP ───
PORT=3000
NODE_ENV=development

# Gateway is an HTTP edge proxy — no direct MongoDB access. All data goes
# through microservices via RabbitMQ RPC. Do NOT add MONGO here.

# ─── Redis (TokenStoreService — refresh-token blacklist) (*) ───
REDIS_URL=redis://localhost:6379

# ─── RabbitMQ (RPC client proxies for the microservices) (*) ───
RABBITMQ_URL=amqp://localhost:5672
# Prefixes every queue so stages sharing a broker don't cross-deliver.
RMQ_QUEUE_PREFIX=dev

# ─── JWT (*) ───
# Generate secure random: openssl rand -hex 64
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_DEVICE_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_DEVICE_EXPIRES_IN=365d

# ─── OAuth verifiers ─────────────────────────────────────────────────────────
# VK ID issues a DIFFERENT App ID per mobile platform (Android / iOS). An
# idToken minted by the client carries `aud = <the platform's App ID>`, so the
# backend must accept both. App IDs are public (not secrets). At least one MUST
# be set or gateway startup fails fast.
VK_ANDROID_APP_ID=
VK_IOS_APP_ID=
VK_ANDROID_SERVICE_TOKEN=
VK_IOS_SERVICE_TOKEN=
# Optional URL overrides — defaults are baked into the verifier services.
# VK_PUBLIC_INFO_URL=
# VK_USERINFO_URL=
# YANDEX_USERINFO_URL=
# Yandex ID needs no backend client credentials — verification is done by
# calling the userinfo endpoint with the user's access token.

# ─── Observability ───
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
RELEASE_TAG=
LOG_LEVEL=
LOG_FORMAT=
